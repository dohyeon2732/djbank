# 로컬: 이 내용을 djbank.env 파일로 저장하고 값을 채웁니다(커밋되지 않습니다).
# Vercel: 프로젝트 Settings > Environment Variables에 같은 이름으로 등록합니다.

# 엔진 API 키
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=

# Supabase. 없으면 로컬에서는 public/data 파일에 저장합니다.
SUPABASE_URL=
# 공개 키(sb_publishable_...). 로그인에 씁니다.
SUPABASE_PUBLISHABLE_KEY=
# 비밀 키(sb_secret_...). 서버만 읽습니다. 절대 화면 코드나 저장소에 넣지 않습니다.
SUPABASE_SERVICE_ROLE_KEY=

# 로컬에서만: 테이블을 만들 때(npm run db:schema) 쓰는 DB 연결 문자열. Vercel에는 넣지 않습니다.
SUPABASE_DB_URL=

# Vercel에서만: 실행 탭을 쓸 수 있는 계정 이메일(쉼표로 구분). 비어 있으면 아무도 실행할 수 없습니다.
RUNNER_ALLOWED_EMAILS=
